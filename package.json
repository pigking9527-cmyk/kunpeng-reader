{
  "name": "kunpeng-reader-desktop",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "license:check": "node scripts/check-licenses.mjs",
    "ip:check": "node scripts/check-ip-clean-snapshot.mjs",
    "release:license-gate": "node scripts/assert-public-release-allowed.mjs",
    "lint": "eslint apps packages",
    "test:typed": "node scripts/run-typescript-tests.mjs",
    "test:reader-sample-recorder": "node scripts/test-record-reader-sample.mjs",
    "test:reader-sample-record": "node scripts/test-record-reader-sample.mjs && node scripts/test-validate-reader-sample-record.mjs",
    "test:legacy-ui": "node scripts/run-legacy-ui-tests.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "desktop-ui:build": "vite build --config apps/desktop-ui/vite.pdf-engine.config.ts && vite build --config apps/desktop-ui/vite.reader-protocol.config.ts && node apps/desktop-ui/scripts/verify-pdf-adapter-output.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "24.10.1",
    "eslint": "^9.35.0",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.42.0",
    "vite": "7.1.5"
  }
}
