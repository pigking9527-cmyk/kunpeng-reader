{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kunpeng-reader.invalid/contracts/intelligence/host-inference-v1.schema.json",
  "title": "Kunpeng intelligence-host encrypted inference relay V1",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 16, "maxLength": 11184812 },
    "keyId": { "type": "string", "pattern": "^key:[A-Za-z0-9._:-]{1,120}$" },
    "keyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation": {
      "enum": ["library_answer", "library_compare", "reading_deep_analysis", "reading_memory", "news_preference", "news_evidence_review", "companion_prompt"]
    },
    "encryptedEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "suite", "recipientKeyId", "senderKeyId", "enc", "ciphertext", "ciphertextSha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "suite": { "const": "HPKE-v1-X25519-HKDF-SHA256-CHACHA20POLY1305" },
        "recipientKeyId": { "$ref": "#/$defs/keyId" },
        "senderKeyId": { "$ref": "#/$defs/keyId" },
        "enc": { "$ref": "#/$defs/base64url", "$comment": "HPKE encapsulated ephemeral public key, never a plaintext request field." },
        "ciphertext": { "$ref": "#/$defs/base64url" },
        "ciphertextSha256": { "$ref": "#/$defs/sha256" },
        "compression": { "enum": ["none", "zstd"] }
      }
    },
    "pairingOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "offerId", "expiresAt", "hostInstallationId", "hostKeyId", "hostPublicKey", "capabilities"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "offerId": { "$ref": "#/$defs/id" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "hostInstallationId": { "$ref": "#/$defs/id" },
        "hostKeyId": { "$ref": "#/$defs/keyId" },
        "hostPublicKey": { "$ref": "#/$defs/base64url" },
        "hostKeyFingerprint": { "$ref": "#/$defs/keyFingerprint" },
        "capabilities": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } }
      }
    },
    "hostPairing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "pairId", "state", "hostInstallationId", "hostKeyId", "clientKeyId", "capabilityRevision", "capabilities", "createdAt", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "pairId": { "$ref": "#/$defs/id" },
        "state": { "enum": ["ACTIVE", "REVOKED", "EXPIRED"] },
        "hostInstallationId": { "$ref": "#/$defs/id" },
        "hostKeyId": { "$ref": "#/$defs/keyId" },
        "clientKeyId": { "$ref": "#/$defs/keyId" },
        "capabilityRevision": { "type": "integer", "minimum": 1 },
        "capabilities": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "taskState": {
      "enum": ["QUEUED", "CLAIMED", "RUNNING", "RESULT_READY", "CANCEL_REQUESTED", "CANCELLED", "EXPIRED", "FAILED", "PURGED"]
    },
    "taskRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "pairId", "operation", "capabilityRevision", "expiresAt", "requestEnvelope"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskId": { "$ref": "#/$defs/id" },
        "pairId": { "$ref": "#/$defs/id" },
        "operation": { "$ref": "#/$defs/operation" },
        "capabilityRevision": { "type": "integer", "minimum": 1 },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "requestEnvelope": { "$ref": "#/$defs/encryptedEnvelope" }
      }
    },
    "taskReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "state", "createdAt", "expiresAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskId": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/taskState" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "cancelledAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "hostTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "pairId", "operation", "capabilityRevision", "state", "expiresAt", "requestEnvelope"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskId": { "$ref": "#/$defs/id" },
        "pairId": { "$ref": "#/$defs/id" },
        "operation": { "$ref": "#/$defs/operation" },
        "capabilityRevision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["QUEUED", "CANCEL_REQUESTED"] },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "requestEnvelope": { "$ref": "#/$defs/encryptedEnvelope" }
      }
    },
    "encryptedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "resultEnvelope"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskId": { "$ref": "#/$defs/id" },
        "resultEnvelope": { "$ref": "#/$defs/encryptedEnvelope" }
      }
    },
    "taskResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "state", "expiresAt", "resultEnvelope"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskId": { "$ref": "#/$defs/id" },
        "state": { "const": "RESULT_READY" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "resultEnvelope": { "$ref": "#/$defs/encryptedEnvelope" }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "taskId", "requestedAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "taskId": { "$ref": "#/$defs/id" },
        "requestedAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
