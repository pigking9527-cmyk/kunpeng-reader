{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pigking9527-cmyk/kunpeng-reader/contracts/sync/entities.schema.json",
  "title": "Kunpeng Reader sync entity envelope",
  "type": "object",
  "required": ["id", "kind", "updated_at", "deleted_at", "device_id", "sync_version", "payload"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["reading_progress", "bookmark", "highlight", "annotation", "rating", "tag", "booklist", "booklist_item", "vocabulary", "reading_stat", "ai_reader_config_v1", "translation_config_v1", "ai_reader_history_v1", "secret_bundle_v1"]
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "deleted_at": { "type": ["string", "null"], "format": "date-time" },
    "device_id": { "type": "string", "minLength": 1 },
    "sync_version": { "type": "integer", "minimum": 1 },
    "payload": { "type": "object" }
  },
  "additionalProperties": true
}
