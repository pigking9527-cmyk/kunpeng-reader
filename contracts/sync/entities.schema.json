{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pigking9527-cmyk/kunpeng-reader/contracts/sync/entities.schema.json",
  "title": "Kunpeng Reader sync entity envelope",
  "type": "object",
  "required": ["id", "kind", "updated_at", "deleted_at", "device_id", "sync_version", "payload"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["reading_progress", "bookmark", "highlight", "annotation", "rating", "tag", "booklist", "booklist_item", "vocabulary", "reading_stat", "book_state_v2", "user_book_tags_v1", "book_collections_v1", "model_book_tags_v1", "vocab", "reading_bucket_v2", "ai_reader_config_v1", "translation_config_v1", "ai_reader_history_v1", "secret_bundle_v1", "reader_palette_v1", "reader_palette_order_v1", "app_settings_v1"]
    },
    "updated_at": {
      "description": "Canonical Unix epoch milliseconds. The service temporarily normalizes only reasonable legacy epoch-seconds API input before returning this field.",
      "type": "integer",
      "minimum": 0
    },
    "deleted_at": {
      "description": "0 for an active entity; otherwise the canonical Unix epoch milliseconds of its tombstone.",
      "type": "integer",
      "minimum": 0
    },
    "device_id": { "type": "string", "minLength": 1 },
    "sync_version": { "type": "integer", "minimum": 1 },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "book_state_v2" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/bookStateV2Payload" }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "user_book_tags_v1" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/userBookTagsV1Payload" }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "book_collections_v1" } } },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/bookCollectionsV1Payload" }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "reader_palette_v1" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/readerPaletteV1Payload" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "reader_palette_order_v1" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/readerPaletteOrderV1Payload" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "app_settings_v1" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/appSettingsV1Payload" } } }
    }
  ],
  "$defs": {
    "readerPaletteV1Payload": {
      "description": "One user-defined reading palette. New clients use a content-addressed background asset reference; legacy backgroundImage data URLs remain readable only during migration. An asset is PNG/JPG/WebP/GIF and at most 10 MiB; an account may have at most 10 active custom palettes.",
      "type": "object",
      "required": ["version", "id", "name", "background", "text", "link", "selection", "footnote", "border", "theme"],
      "properties": {
        "version": { "const": 1 }, "id": { "type": "string", "pattern": "^custom-", "maxLength": 80 }, "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "background": { "$ref": "#/$defs/hexColor" }, "text": { "$ref": "#/$defs/hexColor" }, "link": { "$ref": "#/$defs/hexColor" }, "selection": { "$ref": "#/$defs/hexColor" }, "footnote": { "$ref": "#/$defs/hexColor" }, "border": { "$ref": "#/$defs/hexColor" },
        "theme": { "enum": ["light", "dark", "sepia"] },
        "backgroundImage": { "description": "Legacy read-compatible data URL only; new clients must write an empty string and use backgroundAsset fields.", "type": "string", "maxLength": 15728640 },
        "backgroundAssetId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "backgroundAssetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "backgroundAssetMime": { "enum": ["image/png", "image/jpeg", "image/webp", "image/gif"] },
        "backgroundAssetBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
      }, "additionalProperties": false
    },
    "readerPaletteOrderV1Payload": {
      "type": "object", "required": ["version", "order"],
      "properties": { "version": { "const": 1 }, "order": { "type": "array", "maxItems": 13, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } } }, "additionalProperties": false
    },
    "appSettingsV1Payload": {
      "description": "Account-level non-sensitive desktop settings shared by Windows, Linux, and macOS. Unknown fields are preserved so older clients do not damage newer settings.",
      "type": "object",
      "required": ["version", "showReaderJumpBack", "readerJumpBackDismissMode", "readerJumpBackDismissSeconds", "readerJumpBackDismissPages", "readerJumpBackSizeLevel"],
      "properties": {
        "version": { "const": 1 },
        "showReaderJumpBack": { "type": "boolean" },
        "readerJumpBackDismissMode": { "enum": ["pages", "time"] },
        "readerJumpBackDismissSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "readerJumpBackDismissPages": { "type": "integer", "minimum": 1, "maximum": 100 },
        "readerJumpBackSizeLevel": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "additionalProperties": true
    },
    "hexColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$" },
    "userBookTagsV1Payload": {
      "description": "Authoritative user-assigned tags for one content ID. An active empty array is an explicit clear.",
      "type": "object",
      "required": ["schema_version", "content_id", "tags"],
      "properties": {
        "schema_version": { "const": 1 },
        "content_id": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "bookCollectionsV1Payload": {
      "description": "Authoritative collection memberships for one content ID. An active empty array is an explicit clear.",
      "type": "object",
      "required": ["schema_version", "content_id", "collections"],
      "properties": {
        "schema_version": { "const": 1 },
        "content_id": { "type": "string", "minLength": 1 },
        "collections": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "bookStateV2Payload": {
      "description": "Portable per-book state. All fields remain optional so clients from before a field was introduced remain readable.",
      "type": "object",
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "content_id": { "type": "string", "minLength": 1 },
        "progress_history": {
          "description": "Daily reading-position summaries. Receiving clients merge same-local-day entries by greatest at, retain at most 3650 days, and preserve other payload fields.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": { "type": "integer", "minimum": 0 },
              "progress": { "type": "number", "minimum": 0, "maximum": 100 },
              "chapter": { "type": "integer", "minimum": 0 },
              "frac": { "type": "number", "minimum": 0, "maximum": 1 },
              "position": { "type": ["object", "null"] }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
