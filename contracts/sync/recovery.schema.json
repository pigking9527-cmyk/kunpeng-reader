{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kunpeng-reader.invalid/sync/recovery.schema.json",
  "title": "Kunpeng Reader sync recovery API objects",
  "oneOf": [
    { "$ref": "#/$defs/statusResponse" },
    { "$ref": "#/$defs/restoreRequest" },
    { "$ref": "#/$defs/restoreResponse" }
  ],
  "$defs": {
    "statusResponse": {
      "type": "object",
      "required": ["ok", "schemaVersion", "serverTime", "dataGeneration", "retentionDays", "available", "enabledAt", "restorableFrom", "latestVersionAt", "versionCount", "compressedBytes", "uncompressedBytes", "lastPrunedAt"],
      "properties": {
        "ok": { "const": true },
        "schemaVersion": { "const": 1 },
        "serverTime": { "type": "integer", "minimum": 0 },
        "dataGeneration": { "type": "integer", "minimum": 1 },
        "retentionDays": { "const": 90 },
        "available": { "type": "boolean" },
        "enabledAt": { "type": "integer", "minimum": 0 },
        "restorableFrom": { "type": "integer", "minimum": 0 },
        "latestVersionAt": { "type": "integer", "minimum": 0 },
        "versionCount": { "type": "integer", "minimum": 0 },
        "compressedBytes": { "type": "integer", "minimum": 0 },
        "uncompressedBytes": { "type": "integer", "minimum": 0 },
        "lastPrunedAt": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "restoreRequest": {
      "type": "object",
      "required": ["password", "confirm", "targetAt", "dataGeneration"],
      "properties": {
        "password": { "type": "string", "minLength": 1 },
        "confirm": { "const": true },
        "targetAt": { "type": "integer", "minimum": 0 },
        "dataGeneration": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "restoreResponse": {
      "type": "object",
      "required": ["ok", "targetAt", "restoredAt", "restoredEntities", "tombstonedEntities", "dataGeneration", "tokensRevoked"],
      "properties": {
        "ok": { "const": true },
        "targetAt": { "type": "integer", "minimum": 0 },
        "restoredAt": { "type": "integer", "minimum": 0 },
        "restoredEntities": { "type": "integer", "minimum": 0 },
        "tombstonedEntities": { "type": "integer", "minimum": 0 },
        "dataGeneration": { "type": "integer", "minimum": 2 },
        "tokensRevoked": { "const": true }
      },
      "additionalProperties": true
    }
  }
}
