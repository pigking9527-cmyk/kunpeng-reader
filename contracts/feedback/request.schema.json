{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kunpeng-reader.invalid/feedback/request.schema.json",
  "title": "Kunpeng Reader feedback request",
  "type": "object",
  "required": ["kind", "text", "appVersion", "platform", "images"],
  "properties": {
    "kind": { "type": "string", "enum": ["bug", "feature"] },
    "text": { "type": "string", "maxLength": 20000 },
    "appVersion": { "type": "string", "maxLength": 80 },
    "platform": { "type": "string", "maxLength": 500 },
    "images": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "mime", "data"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "mime": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] },
          "data": { "type": "string", "contentEncoding": "base64" }
        },
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mime", "data"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\.[jJ][sS][oO][nN]$" },
          "mime": { "const": "application/json" },
          "data": { "type": "string", "contentEncoding": "base64" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "feature" } }, "required": ["kind"] },
      "then": { "properties": { "attachments": { "maxItems": 0 } } }
    }
  ],
  "additionalProperties": false
}
