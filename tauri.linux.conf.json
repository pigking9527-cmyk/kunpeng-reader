{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kunpeng-reader",
  "bundle": {
    "targets": ["appimage", "deb"],
    "linux": {
      "appimage": {
        "files": {
          "/usr/bin/libonnxruntime_providers_cuda.so": "packaging/linux/runtime/libonnxruntime_providers_cuda.so",
          "/usr/bin/libonnxruntime_providers_shared.so": "packaging/linux/runtime/libonnxruntime_providers_shared.so"
        }
      },
      "deb": {
        "desktopTemplate": "packaging/linux/kunpeng-reader.desktop",
        "files": {
          "/usr/bin/libonnxruntime_providers_cuda.so": "packaging/linux/runtime/libonnxruntime_providers_cuda.so",
          "/usr/bin/libonnxruntime_providers_shared.so": "packaging/linux/runtime/libonnxruntime_providers_shared.so"
        }
      }
    }
  }
}
